<resources>

    <style name="DayOfWeek" parent="TextAppearance.AppCompat.Caption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/darker_gray</item>
    </style>

    <style name="StepperText" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/stepper_indicator_inactive</item>
        <item name="android:textColor">@android:color/darker_gray</item>
    </style>

    <style name="StepperLine">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@android:color/darker_gray</item>
    </style>

    <style name="SelectableField" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/item_appointment_bg</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_right</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="textSize_16" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="DialogTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/custom_black_white</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:gravity">left</item>
    </style>

    <style name="DialogMessage">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/custom_black_white</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:gravity">left</item>
    </style>

    <style name="DialogTitle.Delete">
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DialogMessage.Delete">
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textColor">@color/custom_main</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>