<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_box_corners"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/tv_title"
        style="@style/DialogTitle.Delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Удаление" />

    <TextView
        android:id="@+id/tv_message"
        style="@style/DialogMessage.Delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text='"Ресницы"' />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_negative"
            android:layout_width="140dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/corners_btn"
            android:backgroundTint="@color/surface_color"
            android:gravity="center"
            android:text="Отмена"
            android:textAllCaps="false"
            android:textColor="@color/custom_black_white"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_positive"
            android:layout_width="140dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/corners_btn"
            android:backgroundTint="@color/surface_color"
            android:gravity="center"
            android:text="Удалить"
            android:textAllCaps="false"
            android:textColor="@color/red"
            android:textSize="16sp" />

    </LinearLayout>
</LinearLayout>