<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/schedule_nav_graph"
    app:startDestination="@id/scheduleFragment">

    <fragment
        android:id="@+id/scheduleFragment"
        android:name="com.avetiso.feature_schedule.ui.ScheduleFragment"
        android:label="fragment_schedule"
        tools:layout="@layout/fragment_schedule">
        <action
            android:id="@+id/action_scheduleFragment_to_addAppointmentFragment"
            app:destination="@id/addAppointmentFragment" />
    </fragment>

    <fragment
        android:id="@+id/addAppointmentFragment"
        android:name="com.avetiso.feature_schedule.add_appointment.ui.AddAppointmentFragment"
        android:label="fragment_add_appointment"
        tools:layout="@layout/fragment_add_appointment">

        <argument
            android:name="appointmentId"
            app:argType="long"
            android:defaultValue="-1L" />

        <argument
            android:name="selectedDate"
            app:argType="string" />

        <action
            android:id="@+id/action_addAppointmentFragment_to_addServiceFragment"
            app:destination="@id/addServiceFragment">
            <argument
                android:name="serviceToEdit"
                android:defaultValue="@null"
                app:argType="com.avetiso.core.entity.ServiceEntity"
                app:nullable="true" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/addServiceFragment"
        android:name="com.avetiso.feature_schedule.add_appointment.steps.step1.add_service.ui.AddServiceFragment"
        android:label="AddServiceFragment"
        tools:layout="@layout/fragment_add_service">
        <action
            android:id="@+id/action_addServiceFragment_to_selectCategoryFragment"
            app:destination="@id/selectCategoryFragment" />

        <argument
            android:name="serviceToEdit"
            app:argType="com.avetiso.core.entity.ServiceEntity"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/selectCategoryFragment"
        android:name="com.avetiso.feature_schedule.add_appointment.steps.step1.add_service.category.SelectCategoryFragment"
        android:label="SelectCategoryFragment"
        tools:layout="@layout/fragment_select_category" />

</navigation>